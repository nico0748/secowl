{
  "name": "secowl",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "脆弱性調査支援アプリケーション — 偵察・列挙／脆弱性調査／トリアージ／報告書をローカルのMarkdownで管理する",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "server": "node server/index.js",
    "app": "npm run build && node scripts/patch-electron-app.mjs && electron .",
    "app:nobuild": "node scripts/patch-electron-app.mjs && electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed-mock.js",
    "mcp": "node mcp/server.js",
    "icons": "node scripts/fetch-tool-icons.js",
    "check:colors": "node scripts/check-colors.mjs",
    "test": "node --import ./test/helpers/env.mjs --test \"test/**/*.test.mjs\"",
    "test:unit": "node --import ./test/helpers/env.mjs --test \"test/unit/**/*.test.mjs\"",
    "test:api": "node --import ./test/helpers/env.mjs --test \"test/api/**/*.test.mjs\"",
    "tokens": "python3 scripts/gen-tokens/gen_tokens.py",
    "postinstall": "node scripts/patch-electron-app.mjs",
    "app:icons": "python3 scripts/gen-icons/gen_icons.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "docx": "^9.5.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "dev.nico0748.secowl",
    "productName": "SecOwl",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "shared/**",
      "mcp/**",
      "knowledge/**",
      "templates/**",
      "dist/**",
      "public/tool-icons/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "SecOwl"
    },
    "asar": false,
    "afterPack": "scripts/after-pack.cjs"
  }
}
